# scheduled/ 디렉토리의 Claude Agent SDK 스크립트에서 사용
# 실제 사용 시 `.env`로 복사 후 값을 채워 넣으세요
ANTHROPIC_API_KEY=

# 선택: 스크립트가 결과를 이메일로 보낼 때 사용할 수신지
NOTIFY_EMAIL=

# ── TimeCapsule PWA 결제 모듈 (Vite 환경 변수, VITE_ 접두사 필수) ─────────────

# Supabase
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=

# TimeCapsule 백엔드 API
VITE_API_BASE_URL=https://api.timecapsule.app

# 결제 공급사 — 운영/테스트 키 중 하나만 채워도 됩니다
VITE_TOSS_CLIENT_KEY=ck_test_
VITE_STRIPE_PUBLIC_KEY=pk_test_
