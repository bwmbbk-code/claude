{
  "mcpServers": {
    "gmail": {
      "type": "http",
      "url": "https://your-mcp-host.example/gmail/mcp",
      "headers": { "Authorization": "Bearer ${GMAIL_MCP_TOKEN}" }
    },
    "calendar": {
      "type": "http",
      "url": "https://your-mcp-host.example/calendar/mcp",
      "headers": { "Authorization": "Bearer ${CALENDAR_MCP_TOKEN}" }
    },
    "notion": {
      "type": "http",
      "url": "https://your-mcp-host.example/notion/mcp",
      "headers": { "Authorization": "Bearer ${NOTION_MCP_TOKEN}" }
    },
    "drive": {
      "type": "http",
      "url": "https://your-mcp-host.example/drive/mcp",
      "headers": { "Authorization": "Bearer ${DRIVE_MCP_TOKEN}" }
    },
    "finance": {
      "type": "http",
      "url": "https://your-mcp-host.example/finance/mcp",
      "headers": { "Authorization": "Bearer ${FINANCE_MCP_TOKEN}" }
    }
  }
}
